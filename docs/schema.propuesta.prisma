// SanfeFer — modelo de datos (propuesta v1)
// Dinero: Decimal(10,2) en quetzales (GTQ). Cantidades: Decimal(12,3). Costos unitarios: Decimal(12,4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Supabase: conexión directa para migraciones
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  ADMIN
  SELLER
}

enum MeasureUnit {
  UNIT // unidad (botella, lata, limón)
  ML
  G
}

enum InventoryItemKind {
  SUPPLY // insumo: clamato, limón, tajín
  RESALE // reventa: cerveza en botella/lata
}

enum MovementType {
  INITIAL // stock inicial
  PURCHASE // entrada por compra
  PURCHASE_VOID // anulación de compra
  SALE // salida por venta (al enviar a barra)
  SALE_VOID // devolución por ítem anulado antes de prepararse
  WASTE // merma / salida manual
  MANUAL_IN // entrada manual
  ADJUSTMENT // ajuste por conteo físico
}

enum PurchaseStatus {
  RECEIVED
  VOIDED
}

enum TabStatus {
  OPEN
  PAID
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  DELIVERED
  CANCELLED
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum PaymentMethod {
  CASH
  CARD
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  IN
  OUT
}

// ───────────────────────── Usuarios y configuración ─────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  name         String
  username     String    @unique
  role         Role
  pinHash      String? // vendedores: PIN 4-6 dígitos (bcrypt)
  passwordHash String? // administradores: contraseña (bcrypt)
  active       Boolean   @default(true)
  tokenVersion Int       @default(0) // se incrementa para invalidar sesiones
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tabsOpened         Tab[]               @relation("TabOpenedBy")
  tabsClosed         Tab[]               @relation("TabClosedBy")
  ordersSent         Order[]
  itemsCancelled     OrderItem[]         @relation("ItemCancelledBy")
  paymentsReceived   Payment[]
  cashSessionsOpened CashSession[]       @relation("CashOpenedBy")
  cashSessionsClosed CashSession[]       @relation("CashClosedBy")
  cashMovements      CashMovement[]
  purchasesCreated   Purchase[]          @relation("PurchaseCreatedBy")
  purchasesVoided    Purchase[]          @relation("PurchaseVoidedBy")
  inventoryMovements InventoryMovement[]
}

model Setting {
  id                     Int      @id @default(1) // fila única
  businessName           String   @default("SanfeFer")
  address                String?
  phone                  String?
  taxId                  String? // NIT, solo informativo en el ticket
  currency               String   @default("GTQ")
  timezone               String   @default("America/Guatemala")
  serviceChargeRate      Decimal  @default(10) @db.Decimal(5, 2) // %
  serviceChargeByDefault Boolean  @default(false)
  allowNegativeStock     Boolean  @default(true)
  ticketFooter           String?  @default("¡Gracias por su visita!")
  printerConfig          Json? // ancho de papel (58/80 mm), conexión ESC/POS
  updatedAt              DateTime @updatedAt
}

// ───────────────────────── Catálogo ─────────────────────────

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  color     String? // token de la paleta para el botón en el POS
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       Category               @relation(fields: [categoryId], references: [id])
  recipe         ProductComponent[] // qué descuenta del inventario
  modifierGroups ProductModifierGroup[]
  orderItems     OrderItem[]

  @@unique([categoryId, name])
}

// Receta: una cerveza consume 1 UNIT de su artículo; una michelada consume ml de clamato, limón, etc.
model ProductComponent {
  id              Int     @id @default(autoincrement())
  productId       Int
  inventoryItemId Int
  quantity        Decimal @db.Decimal(12, 3) // en la unidad del artículo

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([productId, inventoryItemId])
}

// "Tipo de michelada" (elige 1, obligatorio), "Escarchado" (0..1), "Extras" (0..n)
model ModifierGroup {
  id        Int                    @id @default(autoincrement())
  name      String                 @unique
  minSelect Int                    @default(0) // >= 1 → obligatorio
  maxSelect Int                    @default(1) // 1 → elección única
  sortOrder Int                    @default(0)
  active    Boolean                @default(true)
  options   ModifierOption[]
  products  ProductModifierGroup[]
}

model ModifierOption {
  id         Int     @id @default(autoincrement())
  groupId    Int
  name       String
  priceDelta Decimal @default(0) @db.Decimal(10, 2)
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  group      ModifierGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  components ModifierOptionComponent[] // p. ej. "Con Corona" consume 1 Corona; "Tajín" consume 10 g
  orderItems OrderItemModifier[]

  @@unique([groupId, name])
}

model ModifierOptionComponent {
  id              Int     @id @default(autoincrement())
  optionId        Int
  inventoryItemId Int
  quantity        Decimal @db.Decimal(12, 3)

  option        ModifierOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id])

  @@unique([optionId, inventoryItemId])
}

model ProductModifierGroup {
  productId Int
  groupId   Int
  sortOrder Int @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
}

// ───────────────────────── Inventario ─────────────────────────

model InventoryItem {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  kind        InventoryItemKind
  unit        MeasureUnit
  stock       Decimal           @default(0) @db.Decimal(12, 3)
  minStock    Decimal           @default(0) @db.Decimal(12, 3) // alerta cuando stock <= minStock
  averageCost Decimal           @default(0) @db.Decimal(12, 4) // costo promedio ponderado por unidad
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  productComponents  ProductComponent[]
  modifierComponents ModifierOptionComponent[]
  purchaseItems      PurchaseItem[]
  movements          InventoryMovement[]
}

// Historial inmutable: cada cambio de stock deja una fila
model InventoryMovement {
  id              Int          @id @default(autoincrement())
  inventoryItemId Int
  type            MovementType
  quantity        Decimal      @db.Decimal(12, 3) // + entrada / − salida
  unitCost        Decimal?     @db.Decimal(12, 4)
  stockAfter      Decimal      @db.Decimal(12, 3)
  reason          String?
  userId          Int
  purchaseItemId  Int?
  orderItemId     Int?
  createdAt       DateTime     @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  purchaseItem  PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
  orderItem     OrderItem?    @relation(fields: [orderItemId], references: [id])

  @@index([inventoryItemId, createdAt])
  @@index([type, createdAt])
}

// ───────────────────────── Compras ─────────────────────────

model Supplier {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  contactName String?
  phone       String?
  email       String?
  taxId       String?
  notes       String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases   Purchase[]
}

model Purchase {
  id            Int            @id @default(autoincrement())
  supplierId    Int
  invoiceNumber String?
  purchasedAt   DateTime       @db.Date
  total         Decimal        @db.Decimal(10, 2)
  notes         String?
  status        PurchaseStatus @default(RECEIVED)
  createdById   Int
  voidedById    Int?
  voidedAt      DateTime?
  voidReason    String?
  createdAt     DateTime       @default(now())

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  createdBy User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  voidedBy  User?          @relation("PurchaseVoidedBy", fields: [voidedById], references: [id])
  items     PurchaseItem[]

  @@index([purchasedAt])
}

model PurchaseItem {
  id              Int     @id @default(autoincrement())
  purchaseId      Int
  inventoryItemId Int
  quantity        Decimal @db.Decimal(12, 3) // en la unidad base del artículo
  unitCost        Decimal @db.Decimal(12, 4)
  subtotal        Decimal @db.Decimal(10, 2)

  purchase      Purchase            @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem       @relation(fields: [inventoryItemId], references: [id])
  movements     InventoryMovement[]
}

// ───────────────────────── POS ─────────────────────────

model DiningTable {
  id        Int     @id @default(autoincrement())
  name      String  @unique // "Mesa 1", "Barra 3"
  zone      String? // "Salón", "Terraza"
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  tabs      Tab[]
}

// Cuenta individual. Una mesa ocupada = 1..n cuentas OPEN con ese tableId.
// tableId = null → cliente independiente (sin mesa).
model Tab {
  id                Int           @id @default(autoincrement()) // folio
  tableId           Int?
  customerName      String // "Cliente 1", "Juan"; obligatorio sin mesa
  status            TabStatus     @default(OPEN)
  discountType      DiscountType?
  discountValue     Decimal?      @db.Decimal(10, 2)
  discountReason    String?
  serviceChargeRate Decimal?      @db.Decimal(5, 2) // null = sin cargo por servicio
  // Totales congelados al cobrar
  subtotal          Decimal       @default(0) @db.Decimal(10, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(10, 2)
  serviceCharge     Decimal       @default(0) @db.Decimal(10, 2)
  total             Decimal       @default(0) @db.Decimal(10, 2)
  businessDate      DateTime?     @db.Date // día calendario (America/Guatemala) del cobro
  splitFromId       Int? // cuenta de origen al dividir
  cancelReason      String?
  openedById        Int
  closedById        Int?
  openedAt          DateTime      @default(now())
  closedAt          DateTime?

  table     DiningTable? @relation(fields: [tableId], references: [id])
  splitFrom Tab?         @relation("TabSplit", fields: [splitFromId], references: [id])
  splits    Tab[]        @relation("TabSplit")
  openedBy  User         @relation("TabOpenedBy", fields: [openedById], references: [id])
  closedBy  User?        @relation("TabClosedBy", fields: [closedById], references: [id])
  orders    Order[]
  items     OrderItem[]
  payments  Payment[]

  @@index([status, tableId])
  @@index([businessDate])
}

// Comanda: un envío a barra/preparación (agrupa los ítems enviados juntos)
model Order {
  id          Int      @id @default(autoincrement())
  tabId       Int // cuenta en la que se tomó
  createdById Int
  sentAt      DateTime @default(now())

  tab       Tab         @relation(fields: [tabId], references: [id])
  createdBy User        @relation(fields: [createdById], references: [id])
  items     OrderItem[]

  @@index([sentAt])
}

model OrderItem {
  id              Int             @id @default(autoincrement())
  tabId           Int // cuenta actual (cambia al mover ítems entre cuentas)
  orderId         Int // comanda con la que se envió
  productId       Int
  productName     String // snapshot
  quantity        Int
  unitPrice       Decimal         @db.Decimal(10, 2) // precio base + extras (snapshot)
  unitCost        Decimal         @db.Decimal(12, 4) // costo de receta + extras al enviar
  discountAmount  Decimal         @default(0) @db.Decimal(10, 2)
  note            String?
  status          OrderItemStatus @default(PENDING)
  statusChangedAt DateTime        @default(now())
  cancelledById   Int?
  cancelReason    String?
  createdAt       DateTime        @default(now())

  tab         Tab                 @relation(fields: [tabId], references: [id])
  order       Order               @relation(fields: [orderId], references: [id])
  product     Product             @relation(fields: [productId], references: [id])
  cancelledBy User?               @relation("ItemCancelledBy", fields: [cancelledById], references: [id])
  modifiers   OrderItemModifier[]
  movements   InventoryMovement[]

  @@index([tabId])
  @@index([status, createdAt])
}

model OrderItemModifier {
  id          Int     @id @default(autoincrement())
  orderItemId Int
  optionId    Int?
  groupName   String // snapshot
  optionName  String // snapshot
  priceDelta  Decimal @db.Decimal(10, 2)

  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    ModifierOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
}

// Varios pagos por cuenta → pago mixto (efectivo + tarjeta) y división en partes iguales
model Payment {
  id            Int           @id @default(autoincrement())
  tabId         Int
  cashSessionId Int
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2) // monto aplicado a la cuenta
  tendered      Decimal?      @db.Decimal(10, 2) // efectivo recibido
  change        Decimal?      @db.Decimal(10, 2) // vuelto entregado
  reference     String? // núm. de voucher/autorización de tarjeta
  receivedById  Int
  businessDate  DateTime      @db.Date
  createdAt     DateTime      @default(now())

  tab         Tab         @relation(fields: [tabId], references: [id])
  cashSession CashSession @relation(fields: [cashSessionId], references: [id])
  receivedBy  User        @relation(fields: [receivedById], references: [id])

  @@index([businessDate])
}

// ───────────────────────── Caja ─────────────────────────

model CashSession {
  id            Int               @id @default(autoincrement())
  status        CashSessionStatus @default(OPEN)
  openingAmount Decimal           @db.Decimal(10, 2) // fondo inicial
  expectedCash  Decimal?          @db.Decimal(10, 2) // fondo + efectivo − vueltos ± movimientos
  countedCash   Decimal?          @db.Decimal(10, 2) // arqueo
  difference    Decimal?          @db.Decimal(10, 2) // contado − esperado
  notes         String?
  openedById    Int
  closedById    Int?
  openedAt      DateTime          @default(now())
  closedAt      DateTime?

  openedBy  User           @relation("CashOpenedBy", fields: [openedById], references: [id])
  closedBy  User?          @relation("CashClosedBy", fields: [closedById], references: [id])
  payments  Payment[]
  movements CashMovement[]
}

// Entradas/salidas de efectivo que no son ventas (pago a proveedor, cambio, retiro)
model CashMovement {
  id            Int              @id @default(autoincrement())
  cashSessionId Int
  type          CashMovementType
  amount        Decimal          @db.Decimal(10, 2)
  reason        String
  userId        Int
  createdAt     DateTime         @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
}
