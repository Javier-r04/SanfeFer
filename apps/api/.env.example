# Local (Docker o Postgres instalado). En Supabase:
#   DATABASE_URL = conexión del pooler (puerto 6543) con ?pgbouncer=true
#   DIRECT_URL   = conexión directa (puerto 5432), usada por las migraciones
DATABASE_URL="postgresql://sanfefer:sanfefer@localhost:5432/sanfefer"
DIRECT_URL="postgresql://sanfefer:sanfefer@localhost:5432/sanfefer"

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-bytes"

PORT=4000
# Orígenes permitidos separados por coma (solo necesario si el frontend no usa el proxy)
CORS_ORIGIN="http://localhost:5173"
# Horas que dura la sesión
SESSION_HOURS=12
